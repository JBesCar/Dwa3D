
<launch>
        <arg name="base_link_frame" default="base_link" />
        <arg name="world_frame" default="odom" />
        <arg name="tf_prefix" default=""/>

        <!-- The name of the parameter under which the URDF is loaded -->
        <arg name="model" default="$(find px4_tyrion)/urdf/tyrion_simulation.gazebo.xacro"/> 
        <param name="robot_description" command="$(find xacro)/xacro '$(arg model)' base_link_frame:=$(arg base_link_frame) world_frame:=$(arg world_frame) tf_prefix:=$(arg tf_prefix)" />
        <arg name="robot_description" default="robot_description"/>

        <!-- TF map <=> odom -->
        <node pkg="tf" type="static_transform_publisher" name="broadcaster_odom" args="$0 0 0 0 0 0 map odom 100" />
        <!-- TF odom <=> odom_ned -->
        <!-- <node pkg="tf" type="static_transform_publisher" name="broadcaster_odomNED" args="0 0 0 3.142 0 0 odom odom_ned 100" /> -->
    
        <!-- To update the robot state -->
        <node name="joint_state_publisher" pkg="joint_state_publisher" type="joint_state_publisher" >
            <param name="use_gui" value="false"/>
            <param name="publish_frequency" type="double" value="50.0" />
        </node>

        <node name="robot_state_publisher_tyrion" pkg="robot_state_publisher" type="robot_state_publisher">
        </node>

        <!-- Node to change the tf of the pose given by optitrack to match it with mavros-->
        <!-- <node pkg="px4_tyrion" type="mavros_pose_treatment" name="optitrack_pose_tf" output="screen"/> -->

</launch>