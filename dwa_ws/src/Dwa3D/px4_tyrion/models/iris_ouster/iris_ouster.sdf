<?xml version="1.0" ?>
<sdf version='1.5'>
  <model name='iris_ouster'>

    <include>
      <uri>model://iris</uri>
    </include> 

    <link name='os_lidar'>
        <pose> 0 0 0 0 0 0 </pose>
        <visual name='visual'>
            <pose>0 0 0.05 1.57 0 0</pose>
            <geometry>
                <mesh>
                    <scale>1 1 1</scale>
                    <uri>model://px4_tyrion/meshes/OS0-32.dae</uri>
                </mesh>
            </geometry>
        </visual>
        <sensor name="laser" type="ray">
            <ray>
                <scan>
                    <horizontal>
                    <samples>512</samples>
                    <resolution>1</resolution>
                    <min_angle>-3.14</min_angle>
                    <max_angle>3.14</max_angle>
                    </horizontal>
                    <vertical>
                        <samples>32</samples>
                        <resolution>1</resolution>
                        <min_angle>-0.26</min_angle>
                        <max_angle>0.26</max_angle>
                    </vertical>
                </scan>
                <range>
                    <min>0.5</min>
                    <max>35.0</max>
                    <resolution>0.03</resolution>
                </range>
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.01</stddev>
                </noise>
            </ray>
            <plugin filename="libgazebo_ros_velodyne_laser.so" name="gazebo_ros_laser_controller">
                <topicName>/ouster/points</topicName>
                <frameName>os_lidar</frameName>
                <min_range>0.5</min_range>
                <max_range>35.0</max_range>
                <gaussianNoise>0.008</gaussianNoise>
            </plugin>
            <always_on>1</always_on>
            <update_rate>10</update_rate>
            <visualize>false</visualize>
        </sensor>
    </link>

    <joint name='ouster_joint' type='fixed'>
        <child>os_lidar</child>
        <parent>iris::base_link</parent>
    </joint>

    <include>
        <uri>model://lidar</uri>
        <pose>0 0 0 0 0 0</pose>
        <name>lidar0</name>
    </include>
    <joint name="lidar0_joint" type="fixed">
        <parent>iris::base_link</parent>
        <child>lidar0::link</child>
    </joint>  

  </model>
</sdf>
