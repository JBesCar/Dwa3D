        <plugin name='rosbag' filename='libgazebo_multirotor_base_plugin.so'>
            <robotNamespace/>
            <linkName>base_link</linkName>
            <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
        </plugin>

        <plugin name='rotor1_motor_model' filename='libgazebo_motor_model.so'>
            <robotNamespace/>
            <jointName>rotor_1_joint</jointName>
            <linkName>rotor_1</linkName>
            <turningDirection>cw</turningDirection>
            <timeConstantUp>0.0125</timeConstantUp>
            <timeConstantDown>0.0125</timeConstantDown>
            <maxRotVelocity>17600</maxRotVelocity>
            <motorConstant>1.84e-05</motorConstant>
            <momentConstant>0.06</momentConstant>
            <commandSubTopic>/gazebo/command/motor_speed</commandSubTopic>
            <motorNumber>1</motorNumber>
            <rotorDragCoefficient>0.0005</rotorDragCoefficient>
            <rollingMomentCoefficient>1e-03</rollingMomentCoefficient>
            <motorSpeedPubTopic>/motor_speed/1</motorSpeedPubTopic>
            <rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim>
        </plugin>
        
