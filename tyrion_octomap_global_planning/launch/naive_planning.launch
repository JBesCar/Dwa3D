<launch>


    <!-- The name of the parameter under which the URDF is loaded -->
    <arg name="world_frame" default="odom"/> <!-- This should actually be "/world". See https://github.com/ros-simulation/gazebo_ros_pkgs/pull/324 -->
    <arg name="base_link_frame" default="base_link"/>
    
    <!-- Naive Plan -->
    <node name="naive_planner" pkg="tyrion_octomap_global_planning" type="naive_planning" respawn="false" output="screen">
    </node>

</launch>
